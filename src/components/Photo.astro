---
// Shows your photo if it exists in src/assets/photos/<name>.jpg (or png/webp),
// otherwise a brand-colour panel with the emblem. Astro converts photos to small WebP files at build time.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt?: string;
  tone?: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  optional?: boolean; // render nothing if the photo is missing
  bare?: boolean; // if missing, render only the slot content (no placeholder box)
  class?: string;
}
const { name, alt = '', tone = 'blue', sizes = '100vw', widths = [480, 800, 1200], priority = false, optional = false, bare = false, class: cls = '' } = Astro.props;

const all = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const found = Object.entries(all).find(([p]) => (p.split('/').pop() ?? '').replace(/\.[^.]+$/, '') === name);
const img = found?.[1].default;
---
{img ? (
  <Image
    src={img}
    alt={alt}
    width={Math.max(...widths)}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={72}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class:list={['photo', cls]}
  />
) : optional ? null : bare ? (
  <slot />
) : (
  <div class:list={['ph', 'panel', `tone-${tone}`, cls]} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'}>
    <slot />
  </div>
)}
